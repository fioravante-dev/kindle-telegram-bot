# Copie para .env e preencha. Nunca faça commit do .env.

# --- Telegram ---
# Token do @BotFather (/newbot).
BOT_TOKEN=
# Seu id numérico no Telegram (descubra com @userinfobot). Vazio = o primeiro a mandar /start vira o dono.
OWNER_ID=
# Credenciais de app em https://my.telegram.org/apps (só para o servidor local da Bot API).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Onde o bot fala com a Bot API. Docker Compose já define isto. Sem servidor local, use
# https://api.telegram.org (limite de 20 MB por arquivo).
# BOT_API_URL=http://127.0.0.1:8081
# Se o servidor local roda em container e o bot fora dele: o diretório de trabalho do servidor
# como o servidor vê (SERVER) e como o bot vê (LOCAL).
# BOT_API_DIR_SERVER=/var/lib/telegram-bot-api
# BOT_API_DIR_LOCAL=/var/lib/telegram-bot-api

# --- E-mail (remetente que cada pessoa aprova na Amazon) ---
# Gmail: verificação em 2 etapas ligada + senha de app (myaccount.google.com/apppasswords).
SMTP_USER=voce@gmail.com
SMTP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# MAIL_FROM=voce@gmail.com
# Tamanho máximo do anexo. Gmail: 25 MB por mensagem, ~17 MB de arquivo depois do base64.
# MAX_ATTACH_MB=17

# --- Outros ---
# DATA_DIR=./data
# OUTPUT_PROFILE=kindle_pw3
# COMIC_COLOR=0
